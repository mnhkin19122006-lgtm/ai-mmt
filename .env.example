GROQ_API_KEY=gsk-your-api-key-here
GROQ_MODEL=openai/gpt-oss-20b
# Tùy chọn: ghi đè cấu hình Groq bằng Chat API tương thích OpenAI
# CHAT_API_KEY=your-provider-key
# CHAT_BASE_URL=https://your-provider.example/v1
# CHAT_MODEL=your-provider-model
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_PROVIDER=local
# Chỉ cần nếu dùng EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-your-api-key-here
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=3
MAX_RETRIEVAL_DISTANCE=1.5
PDF_DIRECTORY=data/pdf
FAISS_INDEX_PATH=storage/faiss_index
